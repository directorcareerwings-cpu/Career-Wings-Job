{
  "name": "career-wings",
  "version": "1.0.0",
  "private": true,
  "description": "Career Wings - Full-Stack Job Portal for Northeast India",
  "workspaces": [
    "server",
    "client"
  ],
  "main": "server/dist/index.js",
  "scripts": {
    "postinstall": "pnpm --filter career-wings-server db:generate",
    "dev": "concurrently \"pnpm --filter career-wings-server dev\" \"pnpm --filter career-wings-client dev\"",
    "dev:server": "pnpm --filter career-wings-server dev",
    "dev:client": "pnpm --filter career-wings-client dev",
    "build": "pnpm --filter career-wings-server db:migrate:safe && pnpm --filter career-wings-server build && pnpm --filter career-wings-client build",
    "build:server": "pnpm --filter career-wings-server build",
    "build:client": "pnpm --filter career-wings-client build",
    "start": "node server/dist/index.js",
    "db:migrate:safe": "pnpm --filter career-wings-server db:migrate:safe",
    "db:push": "pnpm --filter career-wings-server db:push",
    "db:seed": "pnpm --filter career-wings-server db:seed",
    "db:audit": "pnpm --filter career-wings-server db:audit",
    "db:verify": "pnpm --filter career-wings-server db:audit",
    "db:backup": "pnpm --filter career-wings-server db:backup",
    "db:restore": "pnpm --filter career-wings-server db:restore",
    "db:studio": "pnpm --filter career-wings-server db:studio"
  },
  "dependencies": {
    "razorpay": "^2.9.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
