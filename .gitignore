# Dependencies
node_modules
.pnpm-store

# Build outputs
# Keep server/dist and client/dist tracked for hosting deployment
build
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.*.local
!.env.example

# Database & SQLite
# Persistent live database & rolling backups (NEVER touched or overwritten by git)
persistent_data/*
!persistent_data/.gitkeep
!persistent_data/backups/
persistent_data/backups/*
!persistent_data/backups/.gitkeep

# Legacy fallback SQLite paths
!prisma/dev.db
!server/prisma/dev.db
!server/prisma/prisma/dev.db
!server/dev.db
!dev.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Uploads & Temporary files
uploads/*
!uploads/.gitkeep
server/uploads/*
!server/uploads/.gitkeep
client/uploads/*
!client/uploads/.gitkeep

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS metadata
.DS_Store
Thumbs.db

deploy_hostinger/
scratch/
