# Dependencies
node_modules
.pnpm-store

# Build outputs
# Keep server/dist and client/dist tracked for hosting deployment
build
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.*.local
!.env.example

# Database & SQLite — STRICTLY IGNORED by Git (NEVER commit or overwrite production data)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Bootstrap template database (read-only initial seed if persistent DB is missing)
!server/prisma/careerwings_template.db

# Persistent production database & rolling backups directory
persistent_data/*
!persistent_data/.gitkeep
!persistent_data/backups/
persistent_data/backups/*
!persistent_data/backups/.gitkeep

# Uploads & Temporary files
uploads/*
!uploads/.gitkeep
server/uploads/*
!server/uploads/.gitkeep
client/uploads/*
!client/uploads/.gitkeep

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS metadata
.DS_Store
Thumbs.db

deploy_hostinger/
scratch/
