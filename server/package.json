{
  "name": "career-wings-server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "node scripts/prepare-db.js && prisma generate --schema=./prisma/schema.prisma",
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/prepare-db.js && prisma generate --schema=./prisma/schema.prisma && tsc",
    "start": "node dist/index.js",
    "db:use:mysql": "node scripts/switch-db.js mysql",
    "db:use:sqlite": "node scripts/switch-db.js sqlite",
    "db:migrate-to-mysql": "tsx src/scripts/migrate-to-mysql.ts",
    "db:export-mysql-dump": "node scripts/export-mysql-dump.js",
    "db:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:migrate:safe": "tsx src/lib/database-safety.ts migrate",
    "db:push": "prisma db push --schema=./prisma/schema.prisma",
    "db:seed": "tsx src/prisma/seed.ts",
    "db:audit": "tsx src/lib/database-safety.ts audit",
    "db:backup": "tsx src/lib/database-safety.ts backup",
    "db:restore": "tsx src/lib/database-safety.ts restore",
    "db:studio": "prisma studio --schema=./prisma/schema.prisma",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "prisma": "^5.14.0",
    "razorpay": "^2.9.2",
    "sharp": "^0.33.4",
    "slugify": "^1.6.6",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.15",
    "@types/uuid": "^9.0.8",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
