# ============================================
# Career Wings — Environment Variables
# Copy this file to .env and fill in values
# ============================================

# --- Server ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Database & Persistent Storage ---
# In production on Hostinger, the database and uploads are stored in PERSISTENT_STORAGE_DIR
# outside the git working directory to guarantee zero data loss during redeployments.
# PERSISTENT_STORAGE_DIR=/home/uXXXX/careerwings_storage
# SQLite local dev (auto-resolved to persistent storage):
DATABASE_URL="file:./dev.db"
# PostgreSQL for production:
# DATABASE_URL="postgresql://user:password@localhost:5432/careerwings?schema=public"

# --- JWT ---
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Razorpay (add your actual keys here) ---
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- Email (Hostinger SMTP / Nodemailer) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@careerwings.in
SMTP_PASS=your-hostinger-email-password
EMAIL_FROM="Career Wings <no-reply@careerwings.in>"

# --- File Storage ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# --- Admin ---
# Default admin credentials (used only during initial seed)
ADMIN_EMAIL=admin@careerwings.in
ADMIN_PASSWORD=Admin@123456

# --- Frontend (Vite env vars — prefix with VITE_) ---
# Set these in client/.env
# VITE_API_URL=http://localhost:5000/api
# VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
